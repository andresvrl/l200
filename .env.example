# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
#
# The Vertex path above needs no secret at all: it authenticates with Application
# Default Credentials, so there is nothing to leak or rotate. GEMINI_API_KEY is the
# only real credential this project can require. Locally it lives in .env, which is
# gitignored; in a deployment it comes from Secret Manager by reference -- set
# gemini_api_key_secret_id in Terraform and the runtime resolves it at start-up.
# Never put the key itself in Terraform, in this file, or in deployment_spec.env.
